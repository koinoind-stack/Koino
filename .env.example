# ═══ CROSSCRAFTED — Environment Variables ═══
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# ─── CANONICAL PRODUCTION URL ───
# The canonical public URL of the deployed app. Used as the metadataBase
# for Open Graph / Twitter cards and for any server-side absolute URL
# construction. MUST be the user-facing domain — never the raw
# *.vercel.app deployment URL.
# In production: set this to https://www.koino.in in Vercel project env vars.
NEXT_PUBLIC_SITE_URL=https://www.koino.in

# ─── DEVELOPMENT ───
# For local development with SQLite:
#   DATABASE_URL=file:./db/custom.db
# For production with Supabase PostgreSQL:
#   DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-[region].pooler.supabase.com:5432/postgres

DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth is REMOVED. We use Supabase Auth now.
# These are no longer needed:
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

# ─── SUPABASE (Auth + DB) ───
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — SERVER ONLY, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── GOOGLE OAUTH (configured in Supabase Dashboard, NOT here) ───
# Unlike next-auth, Google OAuth credentials are entered directly in:
#   Supabase Dashboard → Authentication → Providers → Google
# You do NOT need GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET here.

# ─── BOOTSTRAP ADMIN (optional) ───
# Comma-separated emails to auto-promote to admin role on first sign-in.
# Use this to bootstrap the first admin on a fresh deployment.
# Can be removed once the admin exists in the database.
# BOOTSTRAP_ADMIN_EMAIL=your-email@example.com
# Alias also honored (single-admin config, comma-separated accepted):
# KOINO_ADMIN_EMAIL=your-email@example.com

# ─── DB-TARGET GUARD (Phase 1 Fix 5 — test/prod isolation) ───
# Write-scripts (scripts/*, prisma/seed-*) refuse to run when DATABASE_URL
# looks like production. Two independent detection inputs:
#   1. PRODUCTION_DATABASE_URL — paste the PROD connection string here (in
#      your shell profile, NOT in a committed file) and every guarded script
#      will refuse to run when DATABASE_URL matches the same host+database
#      or the same Supabase project ref.
#   2. NEXT_PUBLIC_SUPABASE_URL (above) — when set to the production project,
#      any DATABASE_URL with the SAME project ref is treated as production.
# Override (visible, deliberate, NOT recommended): ALLOW_PRODUCTION_DB=1
# PRODUCTION_DATABASE_URL=postgresql://postgres.[prod-ref]:[password]@aws-[region].pooler.supabase.com:5432/postgres
# ALLOW_PRODUCTION_DB=0

# ─── YOUVERSION BIBLE PLATFORM (primary provider — OFF until authorized) ───
# Bible provider via the YouVersion Platform REST API
# (https://developers.youversion.com — base https://api.youversion.com/v1).
# The unified provider layer is IMPLEMENTED (server-side only):
#   • /api/bible/versions — licensed version catalogue (YouVersion first,
#     Koino's public-domain KJV/WEB as resilient fallback)
#   • /api/bible/chapter  — chapter text for the ONE reader
# While YOUVERSION_ENABLED is false nothing calls YouVersion and the reader
# uses the existing Koino provider only (today's behavior). Activation =
# owner sets YOUVERSION_ENABLED=true + the App Key together in the SERVER
# environment.
#
# YOUVERSION_APP_KEY is a SERVER-ONLY secret:
#   • never prefix it with NEXT_PUBLIC_ (that would ship it to the browser)
#   • never commit it, log it, or return it in an API response
#   • get the App Key from the YouVersion Platform portal
YOUVERSION_ENABLED=false
YOUVERSION_APP_KEY=
# Optional override for staging/tests; defaults to https://api.youversion.com
# YOUVERSION_API_BASE_URL=https://api.youversion.com
