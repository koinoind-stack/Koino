// CrossCrafted Prisma Schema
// Production database: PostgreSQL (Supabase)
// Local dev also uses PostgreSQL so the schema matches production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER ──────────────────────────────────────────────────────────────────
// Extended from the scaffold User model. totalPoints is the SERVER-SIDE
// source of truth — the browser never writes to it directly.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  emailVerified DateTime?
  role         String   @default("user") // "user" | "admin"
  totalPoints  Int      @default(0) // SERVER-AUTHORITATIVE — never trust client
  // User's preferred UI language. Synced from the LanguageContext cookie
  // when the user signs in. Null = use cookie/browser detection (existing behavior).
  preferredLanguage String? // "en" | "hi" | "bn" | "te" | "mr" | "ta" | "gu" | "ur" | "kn" | "or" | "ml" | "pa" | "as"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ─── PROFILE / ONBOARDING FIELDS ───
  // Added for Koino signup/onboarding flow. All optional so existing users
  // are not forced to migrate. profileCompleted gates the onboarding flow:
  // if false, the user is redirected to /onboarding after signin.
  username         String?  @unique // unique constraint at DB level
  dateOfBirth      DateTime?
  gender           String?  // "male" | "female" | "prefer_not_to_say"
  state            String?  // Indian state — used for church/event/business discovery
  city             String?  // City within the state
  mobileNumber     String?  // Optional — verified only when claiming a prize
  mobileVerified   Boolean  @default(false)
  faithStatus      String?  // "follows_jesus" | "exploring" | "new_to_christianity" | "prefer_not_to_say"
  faithJourney     String?  // "growing" | "new_to_jesus" | "exploring_christianity" | "looking_for_church" | "learn_and_connect"
  profileCompleted Boolean  @default(false)
  // WhatsApp Channel — track prompt shown + clicked (NOT whether user actually
  // followed, since we can't verify that). Used for analytics only.
  whatsappChannelPromptShown Boolean @default(false)
  whatsappChannelClicked    Boolean @default(false)
  // Signup method — "google" | "email" (set by the auth callback)
  signupMethod     String?  // "google" | "email"
  // ─── PROFILE EDITING (Task 49) ───
  bio              String?  // short public bio shown on the profile — max 500 chars, enforced server-side
  usernameChangedAt DateTime? // last time the username was changed — enforces the 30-day cooldown (null = never changed since signup)

  // ─── PROFILE SOCIAL LINKS ───
  // Public "paste your links" fields — stored as normalized https URLs
  // (server normalizes @handles to full URLs; empty/null = hidden).
  website   String? // personal/ministry website — any http(s) host
  instagram String? // https://(www.)instagram.com/<handle>/
  youtube   String? // https://youtube.com/@handle or /channel/… or youtu.be
  facebook  String? // https://(www.)facebook.com/<handle>/ (fb.com aliases ok)
  twitter   String? // https://(twitter|x).com/<handle>

  // ─── COMMUNITY ROLE (self-reported, optional, NOT verified) ───
  // Chosen at onboarding (step "profile"), editable from Edit Profile.
  // "other" stores the free-text description in communityRoleOther.
  // communityRoleVisible gates PUBLIC profile display ONLY — admin member
  // search/filter always sees the raw value. This field never implies any
  // verified-pastor / ministry-leader status.
  communityRole        String? // one of src/lib/community-roles.ts values
  communityRoleOther   String? // free text when communityRole = "other" (≤ 60 chars)
  communityRoleVisible Boolean @default(true) // show role on public profile

  // ─── ADMIN MEMBER MANAGEMENT ───
  accountStatus    String   @default("active") // "active" | "blocked" | "suspended" | "deactivated"
  moderationReason String?  // internal admin reason for blocking/suspending
  verified         Boolean  @default(false) // ✓ Koino Verified (admin-controlled)
  verifiedAt       DateTime?
  verifiedBy       String?  // admin userId who verified
  contributorType  String?  // "Pastor" | "Elder" | "Bible Teacher" | etc.
  permissions      String   @default("[]") // JSON array of permission strings (on User for direct access)

  // Relations
  accounts          Account[]
  sessions          Session[]
  triviaAttempts    TriviaQuestionAttempt[]
  quizSessions      TriviaQuizSession[]
  pointTransactions TriviaPointTransaction[]
  giftRedemptions   GiftRedemption[]
  dailyChallengeAttempts DailyChallengeAttempt[]
  dailySpins        DailySpin[]
  badges            UserBadge[]
  streakFreezes     StreakFreeze[]

  posts Post[]

  // ─── SOCIAL PLATFORM (Task 50) back-relations ───
  likes              PostLike[]
  comments           PostComment[]  @relation("CommentAuthor")
  bookmarks          PostBookmark[] @relation("BookmarkOwner")
  following          Follow[]       @relation("Follower")   // people this user follows
  followers          Follow[]       @relation("Following")  // people who follow this user
  notifications      Notification[] @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")
  blocksMade         Block[]        @relation("Blocker")
  blocksReceived     Block[]        @relation("Blocked")
  reportsFiled       Report[]       @relation("ReportReporter")
  stories            Story[]        @relation("StoryOwner")
  storyViews         StoryView[]    @relation("StoryViewer")

  // Trivia competition relations
  competitionAttempts TriviaCompetitionAttempt[]
  triviaWins          TriviaWinner[]

  // Streak + rewards
  userStreak          UserStreak?
  userRewards         UserReward[]

  // Contributor
  contributor         Contributor?

  // Groups & fellowship
  groupsCreated       Group[]        @relation("GroupCreator")
  groupMemberships    GroupMember[]  @relation("GroupMemberships")

  // In Loving Memory (Part 4)
  memorialsCreated    Memorial[]           @relation("MemorialCreator")
  memorialManagerships MemorialManager[]   @relation("MemorialManagerUser")
  condolencesWritten  MemorialCondolence[] @relation("MemorialCondolenceAuthor")

  // Bible Movies & Video Library (Part 5)
  videoProgress VideoProgress[] @relation("VideoProgressUser")
  videoSaves    VideoSave[]     @relation("VideoSaveUser")
}

// ─── NEXTAUTH TABLES ────────────────────────────────────────────────────────
// Required by NextAuth v4 with the Prisma adapter

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── TRIVIA QUESTIONS ──────────────────────────────────────────────────────
// Seeded from the 25 existing questions. Admins can add more later.
// difficulty: "beginners" | "intermediate" | "skilled" | "expert"
// category: "full_bible" | "new_testament" | "old_testament" | "apologetics" | "life_faith" | "jesus"

model TriviaQuestion {
  id                 String   @id @default(cuid())
  questionId         String   @unique // stable ID like "q1", "beg_fb_001" — used in attempts
  question           String
  options            String   // JSON array of strings
  correctAnswer      Int      // index into options
  explanation        String
  scriptureReference String?
  difficulty         String   // "beginners" | "intermediate" | "skilled" | "expert"
  category           String   // "full_bible" | "new_testament" | etc.
  bibleBook          String?
  topic              String?
  basePoints         Int      // 10 | 20 | 30 | 50
  // JSON-encoded object mapping language code → translated content:
  //   { "hi": { "question": "...", "options": ["...","..."], "explanation": "..." },
  //     "te": { "question": "...", "options": [...], "explanation": "..." }, ... }
  // Empty object {} means no translations yet — fall back to English fields above.
  translations       String   @default("{}")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  attempts           TriviaQuestionAttempt[]
  transactions      TriviaPointTransaction[]
}

// ─── ANTI-FARMING: Question Attempts ───────────────────────────────────────
// THE KEY TABLE: records that a user has already earned points for a question.
// @@unique([userId, questionId]) means a user can only have ONE attempt
// record per question — ever. This is enforced at the DATABASE level,
// so even race conditions (two simultaneous requests) cannot create duplicates.

model TriviaQuestionAttempt {
  id              String   @id @default(cuid())
  userId          String
  questionId      String   // references TriviaQuestion.questionId (stable ID)
  quizSessionId   String?
  pointsAwarded   Int      @default(0) // 0 if practice/already-scored, 10-60 if new
  answeredCorrectly Boolean
  answeredAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        TriviaQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  quizSession     TriviaQuizSession? @relation(fields: [quizSessionId], references: [id])

  @@unique([userId, questionId]) // ← ANTI-FARMING: one score per question per user, EVER
  @@index([userId])
  @@index([questionId])
}

// ─── QUIZ SESSIONS ─────────────────────────────────────────────────────────
// Records each quiz play (both EARN_POINTS and PRACTICE modes)

model TriviaQuizSession {
  id             String   @id @default(cuid())
  userId         String
  difficulty     String
  category       String
  questionIds    String   // JSON array of questionId strings
  score          Int      @default(0) // total points earned THIS session (0 for practice)
  correctCount   Int      @default(0)
  totalQuestions Int
  mode           String   // "EARN_POINTS" | "PRACTICE"
  bestStreak     Int      @default(0)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts       TriviaQuestionAttempt[]
  transactions   TriviaPointTransaction[]

  @@index([userId])
  @@index([mode])
}

// ─── FAITH POINT TRANSACTION HISTORY ───────────────────────────────────────
// Auditable log of every point change. totalPoints is derived from these.

model TriviaPointTransaction {
  id           String   @id @default(cuid())
  userId       String
  questionId   String?  // null for non-question transactions (gift redemption, admin adjustment)
  quizSessionId String?
  points       Int      // positive = earned, negative = spent
  reason       String   // "CORRECT_BEGINNER" | "CORRECT_INTERMEDIATE" | "STREAK_BONUS" | "GIFT_REDEMPTION" | etc.
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     TriviaQuestion? @relation(fields: [questionId], references: [questionId])
  quizSession  TriviaQuizSession? @relation(fields: [quizSessionId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// ─── GIFTS / MERCHANDISE REWARDS ───────────────────────────────────────────
// Admin-managed gifts. The 6 default gifts + admin-added ones.

model Gift {
  id              String   @id @default(cuid())
  giftId          String   @unique // stable ID like "g1", "g_admin_123"
  title           String
  description     String
  imageUrl        String
  pointsRequired  Int
  tier            String   // "bronze" | "silver" | "gold" | "platinum"
  stock           Int      @default(0)
  productId       String?  // references Koino Shop Product.id (mock data array) — when set, product info comes from the Shop
  rewardType      String   @default("fp_reward") // "fp_reward" | "competition_prize" | "streak_milestone"
  // Variations & attributes (JSON-encoded strings).
  // variations: [{"name":"Size","options":["S","M","L","XL"]},{"name":"Color","options":["Black","White"]}]
  // attributes: [{"label":"Material","value":"100% Cotton"}]
  variations      String   @default("[]")
  attributes      String   @default("[]")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  redemptions     GiftRedemption[]
}

// ─── GIFT REDEMPTIONS ──────────────────────────────────────────────────────
// Records when a user claims a gift. @@unique prevents double-claiming.

model GiftRedemption {
  id           String   @id @default(cuid())
  userId       String
  giftId       String   // references Gift.giftId
  giftDbId     String   // references Gift.id (for relation)
  pointsSpent  Int
  status       String   @default("pending") // "pending" | "contacted" | "shipped" | "delivered"
  // JSON-encoded string of the user's chosen variations at the time of redemption.
  // e.g. [{"name":"Size","value":"L"},{"name":"Color","value":"Black"}]
  selectedVariations String @default("[]")
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift         Gift     @relation(fields: [giftDbId], references: [id])

  @@unique([userId, giftId]) // ← one redemption per gift per user
  @@index([userId])
}

// ─── EXISTING SCAFFOLD (preserved) ─────────────────────────────────────────

// ─── SOCIAL PLATFORM (Task 50) ───
// The original Post model was an unused scaffold (zero code references) and
// is evolved IN PLACE into the social post model. `title` becomes optional;
// `content` is the caption. Media lives in Supabase Storage, referenced by URL.
model Post {
  id        String   @id @default(cuid())
  title     String?  // optional — legacy field, kept nullable for backward compatibility
  content   String?  // caption text (hashtags/mentions parsed server-side into indices)
  published Boolean  @default(false)
  authorId  String
  // Media: "text" | "image" | "video". mediaUrls is a JSON array of storage URLs.
  mediaType    String   @default("text")
  mediaUrls    String   @default("[]") // JSON string[] — up to 10 images or 1 video
  thumbnailUrl String?  // poster frame for videos (client-captured; server generation is future work)
  aspectRatio  String?  // e.g. "1:1" | "4:5" | "16:9" | "9:16"
  hashtags     String[] // parsed from caption — powers Explore hashtag grids
  // Denormalized counters — maintained inside short $transactions on toggle.
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  repostCount  Int      @default(0)
  viewCount    Int      @default(0)
  isReel       Boolean  @default(false) // true = surfaces in the Reels vertical feed
  // Reposts: a repost is a new Post whose content quotes/references the original.
  repostedFromId String?
  groupId      String?  // set when the post belongs to a Group (scoped to the group page)
  editedAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  repostedFrom Post?           @relation("PostReposts", fields: [repostedFromId], references: [id], onDelete: SetNull)
  reposts      Post[]          @relation("PostReposts")
  likes        PostLike[]
  comments     PostComment[]
  bookmarks    PostBookmark[]
  notifications Notification[]
  group        Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // In Loving Memory: set when this post is a memorial announcement (feed card
  // renders a "View Memorial" button). SetNull: deleting the memorial keeps the post.
  memorial     Memorial?       @relation(fields: [memorialId], references: [id], onDelete: SetNull)
  memorialId   String?
  // Video Library (Part 5): set when this post shares a library video (feed
  // card renders a Watch Now banner). SetNull: deleting the video keeps the post.
  video        Video?          @relation(fields: [videoId], references: [id], onDelete: SetNull)
  videoId      String?

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([isReel, createdAt])
  @@index([groupId, createdAt])
}

// One like per (post, user). Toggle removes/creates + adjusts Post.likeCount.
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

// Comments with one level of replies (parentId → top-level comment only).
model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  parentId  String?  // set only on replies; replies never have children (one level)
  content   String
  createdAt DateTime @default(now())

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([userId])
}

// Saved posts (per-user collection, keyset-paginated).
model PostBookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("BookmarkOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

// Follow graph: follower subscribes to following's posts.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// In-app notifications. type ∈ like | comment | reply | follow | mention | repost | story_reply
model Notification {
  id        String   @id @default(cuid())
  userId    String   // recipient
  actorId   String?  // who triggered it (null for system notifications)
  type      String
  postId    String?
  commentId String?
  storyId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user     User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor    User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  post     Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

// Two-direction block: neither party sees the other anywhere in social.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// User reports on posts/comments/users/stories — reviewed by admins (UI future work).
model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String   // "post" | "comment" | "user" | "story"
  targetId   String
  reason     String?  // short machine-readable reason
  details    String?  // free-text detail from the reporter
  status     String   @default("pending") // pending | reviewed | dismissed
  createdAt  DateTime @default(now())

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// Stories expire 24h after creation (lazy cleanup on read).
model Story {
  id            String   @id @default(cuid())
  userId        String
  mediaUrl      String
  mediaType     String   @default("image") // "image" | "video"
  thumbnailUrl  String?
  aspectRatio   String?
  caption       String?
  backgroundColor String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  user    User        @relation("StoryOwner", fields: [userId], references: [id], onDelete: Cascade)
  views   StoryView[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// One view per (story, user); powers the seen/unseen rings + viewers list.
model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation("StoryViewer", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId, createdAt])
}

// ─── DAILY CHALLENGE ──────────────────────────────────────────────────────
// One curated question per day. All users see the same question.
// Gives 2x FP if answered correctly. Can only answer once.

model DailyChallenge {
  id            String   @id @default(cuid())
  challengeDate String   @unique // YYYY-MM-DD
  questionId    String   // references TriviaQuestion.questionId
  multiplier    Int      @default(2) // 2x FP
  createdAt     DateTime @default(now())

  attempts      DailyChallengeAttempt[]

  @@index([challengeDate])
}

model DailyChallengeAttempt {
  id              String   @id @default(cuid())
  userId          String
  challengeId     String
  selectedAnswer  Int
  isCorrect       Boolean
  pointsAwarded   Int      @default(0)
  answeredAt      DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge       DailyChallenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId]) // one attempt per user per day
  @@index([userId])
}

// ─── DAILY SPIN / TREASURE CHEST ──────────────────────────────────────────
// Once-per-day random reward. Variable ratio reinforcement (addictive).

model DailySpin {
  id           String   @id @default(cuid())
  userId       String
  rewardType   String   // "fp_5" | "fp_10" | "fp_25" | "fp_50" | "fp_100" | "streak_freeze" | "double_fp"
  rewardValue  Int      @default(0)
  spinDate     String   // YYYY-MM-DD
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spinDate]) // one spin per day
  @@index([userId])
}

// ─── BADGES / ACHIEVEMENTS ────────────────────────────────────────────────

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeId     String   // e.g. "first_streak", "bible_scholar", "perfect_score"
  badgeName   String
  badgeIcon   String   // emoji
  badgeDescription String
  unlockedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// ─── STREAK FREEZE ────────────────────────────────────────────────────────

model StreakFreeze {
  id          String   @id @default(cuid())
  userId      String
  activity    String   // "bible_reading" | "trivia_play" | "prayer_share"
  freezeDate  String   // YYYY-MM-DD
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activity, freezeDate])
  @@index([userId])
}

// ─── COMIC BIBLE ───────────────────────────────────────────────────────────
// Bible Comic system. References existing Bible book IDs from bible-data.ts
// (e.g. bookId = "genesis" matches BIBLE_BOOKS[].id).
// Artwork is language-independent — ONE image per panel.
// Text (title, narration, captions) is localized via ComicPanelTranslation.

model ComicChapter {
  id              String   @id @default(cuid())
  comicId         String   @unique // e.g. "genesis-2" — human-readable stable ID
  bookId          String             // e.g. "genesis" — matches BIBLE_BOOKS[].id
  chapter         Int                // e.g. 2
  title           String             // English default title
  coverArtUrl     String?            // optional chapter cover image
  sortOrder       Int      @default(0)
  // Publishing workflow state.
  // draft    — admin started but not finished
  // review   — ready for someone else to QA
  // ready    — QA passed, awaiting publish
  // published — visible to end users (isActive = true AND status = "published")
  status          String   @default("draft") // "draft" | "review" | "ready" | "published"
  description     String?            // short summary shown in CMS + maybe on chapter cards
  adminNotes      String?            // private internal notes for the editorial team
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  panels          ComicPanel[]
  translations    ComicChapterTranslation[]
  quizLinks       ComicChapterQuiz[]

  @@unique([bookId, chapter]) // one comic per book+chapter
  @@index([bookId])
  @@index([status])
}

model ComicPanel {
  id              String   @id @default(cuid())
  panelId         String   @unique // e.g. "GEN2-P01" — stable, human-readable
  comicChapterId  String
  sortOrder       Int      @default(0)
  artworkUrl      String             // ONE image — language-independent
  altText         String?            // accessibility text (screen readers + image fallback)
  verseStart      Int                // e.g. 1
  verseEnd        Int                // e.g. 3
  bookId          String             // denormalized from ComicChapter for quick verse lookups
  chapter         Int                // denormalized
  // Optional audio — language-specific. Null = no audio, use TTS fallback.
  // Future: audioUrl could be a JSON map { "en": "...", "hi": "..." } per language.
  audioUrl        String?            // URL to professional audio narration (future)
  videoUrl        String?            // URL to video content (future)

  comicChapter    ComicChapter @relation(fields: [comicChapterId], references: [id], onDelete: Cascade)
  translations    ComicPanelTranslation[]

  @@index([comicChapterId])
}

model ComicPanelTranslation {
  id              String   @id @default(cuid())
  panelId         String             // FK to ComicPanel.panelId
  lang            String             // "en", "hi", "te", etc.
  title           String?            // Panel title in this language
  narration       String?            // Narration / story text
  captions        String   @default("[]") // JSON array of caption strings (speech bubbles, etc.)

  panel           ComicPanel @relation(fields: [panelId], references: [panelId], onDelete: Cascade)

  @@unique([panelId, lang]) // one translation per panel per language
  @@index([lang])
}

model ComicChapterTranslation {
  id              String   @id @default(cuid())
  comicChapterId  String
  lang            String
  title           String?            // Chapter title in this language

  comicChapter    ComicChapter @relation(fields: [comicChapterId], references: [id], onDelete: Cascade)

  @@unique([comicChapterId, lang])
  @@index([lang])
}

// ─── COMIC → TRIVIA CONNECTION ─────────────────────────────────────────────
// Links a Comic chapter to existing TriviaQuestion records.
// When a user takes a Comic quiz, the API fetches questions via this join table,
// then scores them using the EXISTING submitQuiz() function.
// The same questionId works in both regular Trivia and Comic quiz.
// Anti-farming: @@unique([userId, questionId]) on TriviaQuestionAttempt
// prevents earning FP twice for the same question, regardless of where it was asked.

model ComicChapterQuiz {
  id              String   @id @default(cuid())
  comicChapterId  String
  questionId      String             // references TriviaQuestion.questionId
  sortOrder       Int      @default(0)

  comicChapter    ComicChapter @relation(fields: [comicChapterId], references: [id], onDelete: Cascade)

  @@unique([comicChapterId, questionId]) // one link per chapter+question
  @@index([comicChapterId])
}

// ─── TRIVIA COMPETITIONS ───────────────────────────────────────────────────
// A Competition is a time-boxed Bible Trivia contest with its own
// server-authoritative score (separate from lifetime Faith Points).
// Examples: Daily Challenge, Weekly Bible Challenge, Monthly Championship.
//
// KEY DESIGN DECISIONS:
// - Competition Score is SEPARATE from lifetime FP. The weekly leaderboard
//   ranks by competition score, NOT by lifetime FP.
// - attemptLimit is enforced SERVER-SIDE (not in localStorage).
// - Questions are server-selected — the client never sees correct answers
//   before submitting.
// - Winners are calculated server-side when endAt passes. Immutable records.

model TriviaCompetition {
  id              String   @id @default(cuid())
  title           String
  description     String?
  imageUrl        String?
  type            String   // "daily" | "weekly" | "monthly" | "custom"
  category        String   // "full_bible" | "new_testament" | "old_testament" | "apologetics" | "mixed"
  difficulty      String   // "beginners" | "intermediate" | "skilled" | "expert" | "mixed"
  questionCount   Int      @default(10)
  attemptLimit    Int      @default(1)
  winnerCount     Int      @default(3)
  rules           String?  // free-text rules displayed to users before participating
  status          String   @default("draft") // "draft" | "scheduled" | "live" | "ended" | "cancelled"
  startAt         DateTime
  endAt           DateTime
  claimDeadlineDays Int    @default(7) // days after competition ends to claim prize
  prizeId         String?  // references TriviaPrize.id (optional — some competitions may not have prizes)
  createdById     String?  // admin userId who created it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prize           TriviaPrize?  @relation(fields: [prizeId], references: [id])
  attempts        TriviaCompetitionAttempt[]
  winners         TriviaWinner[]

  @@index([status])
  @@index([type])
  @@index([endAt])
}

// ─── COMPETITION ATTEMPTS ──────────────────────────────────────────────────
// Records a single user's attempt at a competition. The server enforces
// attemptLimit via a count query before accepting a new submission.
// The score here is the COMPETITION score (not lifetime FP).

model TriviaCompetitionAttempt {
  id              String   @id @default(cuid())
  competitionId   String
  userId          String
  questionIds     String   // JSON array of questionId strings (server-selected)
  score           Int      @default(0) // competition score for this attempt
  correctCount    Int      @default(0)
  totalQuestions  Int
  accuracy        Float    @default(0) // 0.0 - 1.0
  durationMs      Int      @default(0) // time taken to complete
  createdAt       DateTime @default(now())

  competition     TriviaCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId, createdAt]) // one attempt per submission
  @@index([competitionId, score]) // for leaderboard queries
  @@index([userId])
}

// ─── PRIZES ─────────────────────────────────────────────────────────────────
// A Prize can be a Koino Merch Store product (sourceType="koino_merch") or
// a custom prize (sourceType="custom"). When linked to a Merch product, the
// prize references the product — it does NOT duplicate product information.

model TriviaPrize {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  imageUrl           String?
  sourceType         String   // "koino_merch" | "custom"
  productId          String?  // references Product.id when sourceType="koino_merch"
  quantity           Int      @default(1) // total available
  assignedQuantity   Int      @default(0) // how many assigned to winners
  remainingQuantity  Int      @default(1) // quantity - assignedQuantity
  approximateValue   Float?   // optional, for display
  requiresShipping   Boolean  @default(true)
  active             Boolean  @default(true)
  terms              String?  // terms & conditions
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  competitions       TriviaCompetition[]
  winners            TriviaWinner[]
}

// ─── WINNERS ───────────────────────────────────────────────────────────────
// Immutable record of a competition winner. Created server-side when a
// competition ends. The status tracks the prize claim workflow.

model TriviaWinner {
  id              String   @id @default(cuid())
  competitionId   String
  userId          String
  rank            Int      // 1st, 2nd, 3rd, etc.
  score           Int      // competition score at time of winning
  correctCount    Int
  accuracy        Float
  durationMs      Int
  prizeId         String?
  status          String   @default("pending_verification")
  // "pending_verification" | "phone_verified" | "contacted" | "address_pending"
  // | "address_verified" | "processing" | "shipped" | "delivered" | "claimed"
  // | "cancelled" | "disqualified" | "expired"
  phoneVerified   Boolean  @default(false)
  phoneVerifiedAt DateTime?
  shippingName    String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingPincode String?
  adminNotes      String?
  disqualifiedReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  competition     TriviaCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prize           TriviaPrize?      @relation(fields: [prizeId], references: [id])

  @@unique([competitionId, userId]) // one winner record per competition per user
  @@index([competitionId, rank])
  @@index([userId])
}

// ─── EVENTS ─────────────────────────────────────────────────────────────────
// User-submitted Christian events. Created by any authenticated user with
// status=PENDING. Admin reviews → PUBLISHED (visible publicly) or REJECTED.
// Admin can also CANCEL a published event (e.g. for moderation).
// The public /api/events endpoint ONLY returns PUBLISHED events.
// The admin /api/admin/events endpoint returns ALL events with optional
// status filter so admin can see pending submissions.

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String
  // Date/time — startDate is required; endDate is optional (single-day events)
  startDate       DateTime
  endDate         DateTime?
  startTime       String?  // "HH:MM"
  endTime         String?  // "HH:MM"
  allDay          Boolean  @default(false)

  // Location
  country         String   @default("India")
  state           String?
  city            String?
  address         String?
  venueName       String?
  location        String   // human-readable summary, e.g. "Palace Grounds, Bengaluru"

  // Online / hybrid
  eventType       String   @default("in-person") // "in-person" | "online" | "hybrid"
  isOnline        Boolean  @default(false)
  onlineUrl       String?

  // Registration
  registrationType String  @default("free") // "free" | "paid" | "registration_required" | "no_registration"
  ticketUrl       String?
  isFree          Boolean  @default(true)
  price           Float    @default(0)

  // Organizer / contact
  organizerName   String?
  organizerEmail  String?
  organizerPhone  String?
  organizerWebsite String?
  whatsappNumber  String?

  // Categorization
  category        String   // "worship" | "bible-study" | "youth" | "retreat" | "conference" | "music" | "prayer" | "other"
  languages       String   @default("[]") // JSON array
  church          String?  // associated church name (if any)

  // Media
  coverImage      String?
  coverGradient   Int      @default(0) // 0-7, used as CSS gradient fallback when no image

  // ─── MODERATION ───
  // status workflow: PENDING (default) → PUBLISHED (admin approved) or
  // REJECTED (admin rejected). PUBLISHED events can be CANCELLED by admin.
  // Public /api/events ONLY returns status=PUBLISHED.
  status          String   @default("PENDING") // "PENDING" | "PUBLISHED" | "REJECTED" | "CANCELLED"
  featured        Boolean  @default(false) // admin can feature an event
  rejectionReason String?  // optional, set when REJECTED
  reviewedBy      String?  // admin email
  reviewedAt      DateTime?

  // Ownership — the user who submitted the event
  createdById     String?  // references User.id (nullable for legacy/seed data)
  createdByEmail  String?  // captured at submission time (in case user is later deleted)

  // ─── GROUP EVENTS (2026-10) ───
  // Events created inside a group reuse THIS table (no duplicate event store).
  // groupId null → submitted via the public/regular flow. groupVisibility
  // controls who sees a group event: "public" events from public groups are
  // also eligible for the main Events section; "members" events are visible
  // to group members only. Private groups always force "members".
  groupId         String?
  groupVisibility String @default("public") // "public" | "members"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([startDate])
  @@index([state, city])
  @@index([category])
  @@index([featured])
  @@index([createdById])
  @@index([groupId])
}

// ─── CHURCHES ───────────────────────────────────────────────────────────────
// User-submitted Christian churches for the public Church Directory.
// Created by any authenticated user with status=PENDING. Admin reviews →
// PUBLISHED (visible publicly) or REJECTED. Admin can also CANCEL a
// published church (e.g. for moderation).
// Public /api/churches ONLY returns status=PUBLISHED.
// Admin /api/admin/churches returns ALL churches with optional status filter.

model Church {
  id              String   @id @default(cuid())
  name            String
  description     String
  denomination    String   @default("") // e.g. "Assemblies of God", "Catholic", "Baptist", "Non-denominational"

  // Location
  country         String   @default("India")
  state           String?
  city            String?
  address         String?
  postalCode      String?
  location        String   // human-readable summary, e.g. "MG Road, Bengaluru"

  // Contact
  pastorName     String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  whatsappNumber String?
  website         String?

  // Service times — JSON array of { day, time, language }
  // e.g. [{"day":"Sunday","time":"9:00 AM","language":"English"}]
  serviceTimes   String   @default("[]")

  // Languages spoken at services — JSON array of strings
  languages       String   @default("[]")

  // Media
  coverImage     String?
  coverGradient  Int      @default(0) // 0-7, CSS gradient fallback when no image

  // ─── MODERATION ───
  // status workflow: PENDING (default) → PUBLISHED (admin approved) or
  // REJECTED (admin rejected). PUBLISHED churches can be CANCELLED by admin.
  // Public /api/churches ONLY returns status=PUBLISHED.
  status          String   @default("PENDING") // "PENDING" | "PUBLISHED" | "REJECTED" | "CANCELLED"
  featured        Boolean  @default(false) // admin can feature a church
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?

  // Ownership — the user who submitted the church
  createdById     String?
  createdByEmail  String?

  // Cosmetic — number of followers (display only, not used for auth)
  followersCount  Int      @default(0)

  // Groups affiliated with this church (display-only link, see Group.churchId)
  groups          Group[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([state, city])
  @@index([denomination])
  @@index([featured])
  @@index([createdById])
}

// ─── PUBLIC WEBSITE CONTENT ────────────────────────────────────────────────
// Admin-editable content for the public Koino website.

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String?
  content         String   // markdown or rich text
  featuredImage   String?
  author          String?
  category        String   // "Bible" | "Faith" | "Christian Living" | etc.
  tags            String   @default("[]") // JSON array
  published       Boolean  @default(false)
  featured        Boolean  @default(false)
  seoTitle        String?
  seoDescription  String?
  // Optional scheduled publish date — post is only public after this date
  // (if set). If null, published=true means immediately visible.
  scheduledAt     DateTime?
  // Optional canonical URL override (for cross-posted articles)
  canonicalUrl    String?
  // JSON array of related BlogPost IDs — shown at the bottom of the article
  relatedArticleIds String @default("[]")
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, publishedAt])
  @@index([category])
  @@index([slug])
}

model HelpArticle {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  category        String   // "Account" | "Bible" | "Bible Trivia" | etc.
  content         String   // markdown or rich text
  featured        Boolean  @default(false)
  published       Boolean  @default(false)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, category])
  @@index([slug])
}

model FounderProfile {
  id              String   @id @default(cuid())
  founderName     String
  profilePhoto    String?
  shortIntro      String?
  biography       String?
  whyIBuiltKoino  String?
  vision          String?
  mission         String?
  founderMessage  String?
  email           String?
  socialLinks     String   @default("[]") // JSON array of {label, url}
  published       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model ContactMessage {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String?
  subject         String
  message         String
  // Status workflow: new → read → replied → closed
  status          String   @default("new") // "new" | "read" | "replied" | "closed"
  // Internal admin notes — NEVER exposed to the user
  adminNotes      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PartnerInquiry {
  id              String   @id @default(cuid())
  name            String
  organization    String?
  email           String
  phone           String?
  website         String?
  partnershipType String   // "Church" | "Ministry" | "Christian Business" | etc.
  message         String
  // Status workflow: new → contacted → archived
  status          String   @default("new") // "new" | "contacted" | "archived"
  // Internal admin notes — NEVER exposed to the user
  adminNotes      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SupportCampaign {
  id              String   @id @default(cuid())
  name            String
  description     String?
  imageUrl        String?
  goalAmount      Float
  raisedAmount    Float    @default(0)
  supporterCount  Int      @default(0)
  currency        String   @default("INR")
  startDate       DateTime?
  endDate         DateTime?
  active          Boolean  @default(true)
  featured       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  donations       Donation[]
}

model Donation {
  id              String   @id @default(cuid())
  campaignId      String
  donorName       String?
  donorEmail       String?
  amount          Float
  currency        String   @default("INR")
  anonymous       Boolean  @default(false)
  status          String   @default("pending") // "pending" | "completed" | "failed" | "refunded"
  transactionRef  String?
  paymentProvider String?  // "razorpay" | "stripe" | etc. — NOT connected yet
  createdAt       DateTime @default(now())

  campaign        SupportCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([status])
}

// ─── DONATION SETTINGS (singleton) ───────────────────────────────────────────
// Admin-configured donation/payment display settings for the /support page.
// Koino does NOT process payments directly — this is informational only.
// Admin configures UPI ID, QR code image, and bank details; the public
// /support page reads these values and displays them. If bank details are
// not configured, the bank transfer section is hidden (no fake data).
//
// Singleton pattern: there is only ever one row (id = "default"). The
// admin API upserts this row. Public API reads it.

model DonationSettings {
  id              String   @id @default("default")
  // UPI
  upiId           String?
  // QR code image URL (stored in Supabase Storage)
  qrCodeUrl       String?
  // Bank transfer
  accountName     String?
  accountNumber   String?
  ifsc            String?
  bankName        String?
  branch          String?
  // Donation message shown on /support
  donationMessage String?
  // Whether donations are currently being accepted (display toggle)
  acceptingDonations Boolean @default(true)
  updatedAt       DateTime @updatedAt
}

// ─── FAITH STREAK (server-authoritative) ────────────────────────────────────
// Tracks consecutive days of meaningful Bible/Trivia activity.
// One calendar day = one streak day (regardless of how many activities).
// The streak is NEVER spent — it measures consistency only.

model UserStreak {
  id              String   @id @default(cuid())
  userId          String   @unique
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDate  String?  // YYYY-MM-DD (server time)
  totalActiveDays Int      @default(0)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentStreak])
}

// ─── KOINO REWARDS ──────────────────────────────────────────────────────────
// Admin-configured rewards that can be unlocked via streak milestones.

model KoinoReward {
  id                String   @id @default(cuid())
  name              String
  description       String?
  rewardType       String   // "DISCOUNT_PERCENT" | "FIXED_VOUCHER" | "FREE_PRODUCT" | "SPECIAL_PRODUCT"
  discountType     String?  // "percent" | "fixed"
  discountValue     Float    @default(0) // e.g., 10 (percent) or 200 (rupees)
  maximumDiscount   Float?   // cap for percent discounts
  minimumOrderValue Float?   // minimum cart total to apply
  productId         String?  // references Product.id when rewardType=FREE_PRODUCT
  inventoryLimit    Int?     // max total redemptions
  expiresAfterDays  Int?     // reward expires N days after issuance
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  milestones        StreakMilestone[]
  userRewards       UserReward[]
}

// ─── STREAK MILESTONES ─────────────────────────────────────────────────────
// Configurable milestone → reward mapping. Admin controls which streak
// threshold unlocks which reward.

model StreakMilestone {
  id                String   @id @default(cuid())
  streakDays        Int      // e.g., 7, 14, 30, 60, 100, 365
  rewardId          String
  repeatable        Boolean  @default(false) // false = once ever; true = once per streak cycle
  active            Boolean  @default(true)
  displayText       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reward            KoinoReward @relation(fields: [rewardId], references: [id])
  userRewards       UserReward[]

  @@unique([streakDays]) // one milestone per streak threshold
  @@index([active])
}

// ─── USER REWARD ENTITLEMENTS ──────────────────────────────────────────────
// Per-user reward record. Created when a milestone is reached.
// Status: AVAILABLE → CLAIMED → REDEEMED (or EXPIRED/CANCELLED)

model UserReward {
  id                String   @id @default(cuid())
  userId            String
  rewardId          String
  milestoneId       String?
  source            String   @default("streak_milestone") // "streak_milestone" | "admin_issued" | "competition_prize"
  sourceMilestone   Int?     // the streak day count that triggered this
  status            String   @default("available") // "available" | "claimed" | "redeemed" | "expired" | "cancelled"
  redemptionCode    String?  // unique code for voucher redemption
  issuedAt          DateTime @default(now())
  claimedAt         DateTime?
  redeemedAt        DateTime?
  expiresAt         DateTime?
  orderId           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward            KoinoReward    @relation(fields: [rewardId], references: [id])
  milestone         StreakMilestone? @relation(fields: [milestoneId], references: [id])

  @@unique([userId, milestoneId]) // prevents duplicate milestone rewards (once-ever default)
  @@index([userId, status])
  @@index([rewardId])
}

// ─── APOLOGETICS + CONTRIBUTOR CMS ─────────────────────────────────────────
// Unified content model for Articles, Blogs, Apologetics, Bible Studies,
// Devotionals. One CMS architecture, multiple content types.

model KoinoArticle {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  contentType     String   // "ARTICLE" | "BLOG" | "APOLOGETICS" | "BIBLE_STUDY" | "DEVOTIONAL"
  category        String?  // e.g., "God & Existence", "Jesus Christ", "Resurrection"
  subcategory     String?
  seriesId        String?  // references ArticleSeries.id
  excerpt         String?
  shortAnswer     String?  // for Apologetics articles
  content         String   // rich text / HTML
  coverImageUrl   String?
  authorId        String?  // references Contributor.id (or null for admin-created)
  authorName      String?  // display name (denormalized for public display)
  status          String   @default("draft") // "draft" | "submitted" | "changes_requested" | "approved" | "published" | "rejected" | "scheduled" | "archived"
  difficulty       String?  // "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
  featured        Boolean  @default(false)
  bibleRefs       String   @default("[]") // JSON array of Bible references (e.g., "John 20:1-29")
  sources         String   @default("[]") // JSON array of source objects
  relatedIds      String   @default("[]") // JSON array of related article IDs
  reviewedBy      String?  // admin userId
  reviewedAt      DateTime?
  reviewNotes     String?  // admin feedback for "changes requested"
  publishedAt     DateTime?
  scheduledAt     DateTime?
  seoTitle        String?
  seoDescription  String?
  canonicalUrl    String?
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  series          ArticleSeries? @relation(fields: [seriesId], references: [id])
  author          Contributor?   @relation(fields: [authorId], references: [id])

  @@index([status, contentType, publishedAt])
  @@index([category])
  @@index([status])
  @@index([slug])
}

model ArticleSeries {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  coverImageUrl   String?
  published       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  articles        KoinoArticle[]
}

model Contributor {
  id              String   @id @default(cuid())
  userId          String   @unique // references User.id
  displayName     String
  slug            String   @unique // for /contributors/[slug]
  profilePhoto    String?
  bio             String?
  church          String?
  churchRole      String?  // "Pastor" | "Elder" | "Bible Teacher" | "Apologist" | etc.
  location        String?
  expertise       String   @default("[]") // JSON array
  website         String?
  socialLinks     String   @default("[]") // JSON array of {label, url}
  verified        Boolean  @default(false) // ✓ Koino Verified Contributor badge
  status          String   @default("pending") // "pending" | "approved" | "rejected" | "suspended"
  permissions     String   @default("[]") // JSON array of permission strings
  applicationId   String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  application     ContributorApplication? @relation(fields: [applicationId], references: [id])
  articles        KoinoArticle[]

  @@index([status])
  @@index([verified])
}

model ContributorApplication {
  id              String   @id @default(cuid())
  fullName        String
  email           String
  userId          String?  // references User.id if applicant is a Koino member
  profilePhoto    String?
  church          String?
  churchRole      String?
  city            String?
  state           String?
  country         String?
  bio             String?
  expertise       String   @default("[]") // JSON array
  website         String?
  socialLinks     String   @default("[]") // JSON array
  whyContribute   String?
  contentInterests String  @default("[]") // JSON array: ["Apologetics", "Blog", etc.]
  sampleUrl       String?
  status          String   @default("pending") // "pending" | "under_review" | "approved" | "rejected" | "suspended"
  adminNotes      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contributor     Contributor?

  @@index([status])
  @@index([createdAt])
}

model UserQuestion {
  id              String   @id @default(cuid())
  question        String
  askerName       String?
  askerEmail      String?
  askerUserId     String?  // references User.id if logged in
  category        String?  // suggested apologetics category
  status          String   @default("new") // "new" | "in_review" | "answered" | "turned_into_article" | "archived"
  adminNotes      String?
  articleId       String?  // if turned into article
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// ─── ROUND 2: GROUPS & FELLOWSHIP ──────────────────────────────────────────
// Faith communities on Koino: Youth Fellowship, Bible Study, Prayer Partners,
// Worship Teams, Christian Entrepreneurs, Church Communities, etc.
// visibility: "public" (anyone can view + join) | "private" (content is
// member-only; joining creates a pending request the owner approves).
model Group {
  id            String   @id @default(cuid())
  name          String
  description   String?
  category      String   @default("fellowship") // youth | bible-study | prayer | worship | entrepreneurs | church | fellowship
  visibility    String   @default("public")     // public | private
  coverGradient Int      @default(0)            // 0-7, gradient fallback for the cover

  // ─── COMMUNITY UPGRADE (2026-10) — additive, nullable where possible ────
  coverImage  String?  // group cover photo (Supabase Storage public URL)
  logoUrl     String?  // group profile picture (Supabase Storage public URL)
  city        String?
  state       String?
  language    String?  // preferred language for group activity
  // joinMode controls who can join PUBLIC groups: "open" joins instantly,
  // "approval" creates a pending request. PRIVATE groups always require
  // owner approval regardless of joinMode.
  joinMode    String   @default("open") // "open" | "approval"
  memberPostPermission String @default("members") // "members" | "admins" — who may publish posts
  rules       String?  // group rules (free text, shown on the About tab)
  pinnedPostId String? // pinned announcement shown atop the Posts tab

  // Church affiliation. Linking is DISPLAY-ONLY: it grants NO permissions on
  // the group to church staff and NO permissions on the church to the group.
  // churchVerified marks an OFFICIAL affiliation and is set exclusively by
  // platform administrators — group managers can never self-badge.
  churchId    String?
  churchName  String?  // display snapshot at link time (church may be renamed)
  churchVerified Boolean @default(false)

  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User          @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   GroupMember[]
  posts     Post[]
  church    Church?       @relation(fields: [churchId], references: [id], onDelete: SetNull)
  events    Event[]

  @@index([category])
  @@index([createdAt])
  @@index([churchId])
}

// Group membership. status: "active" | "pending" (private/approval join request).
// role: "owner" (creator, full control) | "admin" (settings + members) |
// "moderator" (approve requests, remove members, moderate posts) | "member".
model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("member")
  status    String   @default("active")
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// IN LOVING MEMORY (Part 4) — memorial pages, condolences, co-managers.
// Design notes:
//   - gallery follows the Post.mediaUrls convention: JSON string[] of
//     Supabase Storage public URLs (uploaded via /api/social/upload-url).
//   - visibility: "public" (directory + search engines) | "unlisted"
//     (direct link only, noindex) | "private" (managers + admin only).
//   - status: "draft" (creator still writing) | "published" |
//     "unpublished" (hidden by the memorial manager or an administrator).
//   - creatorName/creatorRelation are snapshots for display; the creator is
//     always the first MemorialManager with role "owner".
// ═══════════════════════════════════════════════════════════════════════════
model Memorial {
  id              String    @id @default(cuid())
  fullName        String
  photoUrl        String?
  gallery         String    @default("[]") // JSON string[] of extra photo URLs
  dob             DateTime? // date of birth (if known)
  dod             DateTime? // date of passing
  city            String?
  state           String?
  tribute         String?   // short tribute shown on cards and the feed
  lifeStory       String?   // obituary / life story
  milestones      String?   // family background and life milestones
  qualities       String?   // personal qualities, achievements, memories
  verse           String?   // Bible verse or words of comfort
  verseRef        String?   // e.g. "John 14:1-3" or "Psalm 23"
  visibility      String    @default("public")
  status          String    @default("draft")
  creatorId       String
  creatorName     String    // display snapshot at creation time
  creatorRelation String    // e.g. "Son", "Church friend"
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  creator     User                 @relation("MemorialCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  managers    MemorialManager[]
  condolences MemorialCondolence[]
  posts       Post[]

  @@index([status, visibility, createdAt])
  @@index([state, city])
  @@index([fullName])
}

// Co-manager invited by the owner. The creator's row has role "owner".
model MemorialManager {
  id         String   @id @default(cuid())
  memorialId String
  userId     String
  role       String   @default("manager") // "owner" | "manager"
  addedById  String?
  createdAt  DateTime @default(now())

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  user     User     @relation("MemorialManagerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memorialId, userId])
  @@index([userId])
}

// Condolence message or personal memory/tribute left on a memorial.
// hidden: moderation flag set by managers or admins (message body is kept).
model MemorialCondolence {
  id         String   @id @default(cuid())
  memorialId String
  authorId   String
  authorName String   // display-name snapshot (no private info)
  kind       String   @default("condolence") // "condolence" | "memory"
  body       String
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  author   User     @relation("MemorialCondolenceAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([memorialId, createdAt])
}

// ─── PART 5: BIBLE MOVIES & VIDEO LIBRARY ──────────────────────────────────
// A curated video entry. YouTube-first (official embeds only — no downloading
// or rehosting); `source` is extensible so other authorised providers can be
// added later without a schema change.

model Video {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  summary           String?   // one-line description for cards + feed
  description       String?   // long description shown on the watch page
  source            String    @default("youtube") // "youtube" — future providers welcome
  youtubeId         String?   // 11-character YouTube video id (source = "youtube")
  canonicalUrl      String?   // original watch URL as entered by the admin
  thumbnailUrl      String?   // custom poster; falls back to the YouTube thumbnail
  durationSec       Int?      // entered/verified by admins (oEmbed does not provide it)
  category          String    // "bible_movies" | "ot_stories" | "nt_stories" | "jesus_gospels"
                              // | "animated" | "christian_films" | "sermons" | "worship"
                              // | "documentaries" | "children"
  language          String    @default("en") // video language (one of the 13 Koino UI languages)
  subtitleLanguages String    @default("[]") // JSON string[] of language codes
  dubLanguages      String    @default("[]") // JSON string[] of language codes
  originalLanguage  String?
  contentWarning    String?   // e.g. "Depicts scenes of the crucifixion"
  status            String    @default("draft") // "draft" | "published" | "unpublished"
  featured          Boolean   @default(false)
  embeddable        Boolean   @default(true) // false when YouTube reports embedding disabled
  sourceName        String?   // e.g. "YouTube — Bible Vivid channel"
  rightsNote        String?   // licensing/permission notes recorded by admins
  viewCount         Int       @default(0) // incremented on Watch Now opens
  createdById       String?
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bibleRefs VideoBibleRef[]
  progress  VideoProgress[]
  saves     VideoSave[]
  posts     Post[]

  @@index([status, category, createdAt])
  @@index([status, featured, createdAt])
  @@index([status, language])
  @@index([status, createdAt])
}

// A Bible passage linked to a video. `bookId` uses the BIBLE_BOOKS slugs
// ("genesis", "1samuel", "song_of_solomon", …) so links open the existing reader.
model VideoBibleRef {
  id           String   @id @default(cuid())
  videoId      String
  bookId       String
  chapterStart Int
  verseStart   Int?
  chapterEnd   Int?
  verseEnd     Int?
  createdAt    DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([bookId, chapterStart])
  @@index([videoId])
}

// Playback position for signed-in users — powers Continue Watching and resume.
// Only recorded when the user is signed in; visitors get plain embeds.
model VideoProgress {
  id          String   @id @default(cuid())
  userId      String
  videoId     String
  positionSec Int      @default(0)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation("VideoProgressUser", fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, updatedAt])
}

// Watch Later / Favorite personal lists.
model VideoSave {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  list      String   @default("watch_later") // "watch_later" | "favorite"
  createdAt DateTime @default(now())

  user  User  @relation("VideoSaveUser", fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId, list])
  @@index([userId, list, createdAt])
}
